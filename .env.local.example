# =============================================================================
# Inventory App — Local stack (docker-compose.local.yml)
# =============================================================================
#   cp .env.local.example .env.local
#   docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env.local up --build -d
#
# Same variables as .env.example (production); only the values change. Every
# value here points at the local copy of Supabase that docker-compose.local.yml
# starts, so nothing touches the production database or the production Supabase
# project. These keys only exist on your machine: never use them in production.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API (service: api)
# ---------------------------------------------------------------------------
APP_NAME=Inventory API
LOG_LEVEL=info

# Local Supabase Postgres (service: db). The API connects as `postgres`, like
# it does through the Supabase pooler in production.
POSTGRES_PASSWORD=local-postgres-password
DATABASE_URL=postgresql+asyncpg://postgres:local-postgres-password@db:5432/postgres

# Local Supabase Auth behind the gateway (service: supabase).
# The two keys are JWTs signed with JWT_SECRET, as Supabase issues them.
SUPABASE_URL=http://supabase:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI3NTg0MDB9.Cx2UJHjTxDpSCmJfRWK5vZw3rb6msyT3zV2NPeNnZ84
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4Mjc1ODQwMH0.6halrlvC8pyzojaebZhrtl_z0gHtFUNvUcT4l6GJFhg
JWT_SECRET=62cb6361c01bbb91e981b317b5e1a9cf0a58ada915b8d1d92f9630f157c51c0b

# true skips the confirmation email after registering. Default false, like a
# new Supabase project: open the email at http://localhost:8025.
AUTH_EMAIL_AUTOCONFIRM=false

# Cloudinary has no local version: with these placeholders photo uploads fail
# and everything else works. Put your real values here to test uploads (the
# photos then go to that Cloudinary account).
CLOUDINARY_CLOUD_NAME=local-not-configured
CLOUDINARY_API_KEY=local-not-configured
CLOUDINARY_API_SECRET=local-not-configured

WORKERS=2
ENABLE_SCHEDULER=true

# Empty: cashier invitations are only written to the API log (docker compose logs api).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tu Tiendamiga

SENTRY_DSN=

# ---------------------------------------------------------------------------
# Web App (service: web)
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://api:8001
APP_URL=http://localhost:3010

BRAND_NAME=Tu Tiendamiga
SITE_DOMAIN=tutiendamiga.digital
SUPPORT_EMAIL=hola@localhost
WHATSAPP_NUMBER=
