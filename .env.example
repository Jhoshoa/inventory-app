# =============================================================================
# Inventory App — Production Environment Variables
# =============================================================================
# Copy this file to .env at the project root and fill in your values.
#   cp .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution.
# Dokploy: paste these vars in the Environment Variables UI.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API (service: api)
# ---------------------------------------------------------------------------
APP_NAME=Inventory API
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# PostgreSQL connection string (Supabase) — use the "Session pooler" one.
# Supabase Dashboard > Connect > Session pooler. Two things differ from the
# "Direct connection" string and both are easy to get wrong:
#   - the user is postgres.<project-ref>, not just postgres
#   - the host is aws-0-<region>.pooler.supabase.com (IPv4, port 5432)
# The direct host (db.<ref>.supabase.co) is IPv6-only and fails from many
# networks and containers. Do NOT use the transaction pooler (port 6543).
# Must use the asyncpg driver (postgresql+asyncpg://) and a URL-encoded
# password (@ -> %40, : -> %3A, / -> %2F, # -> %23, ? -> %3F).
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase — used for authentication and service-role operations.
# Project Settings > API Keys. Keep the service-role key secret (backend only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary — used for photo uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Not used to validate Supabase tokens (those are checked against Supabase
# itself), but production refuses to start with a placeholder. Any long random
# value works:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-value

# Public-facing URL of the web app (used for OAuth redirect_to).
FRONTEND_URL=https://your-domain.com

# Comma-separated list of allowed CORS origins.
# For production: https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Workers for gunicorn. 2 is enough for a 2 GB VPS; rate limits are kept in
# memory per worker, so more workers means proportionally looser limits.
WORKERS=2

# Daily jobs (trial expiry, grace period, archiving). Default true.
# With WORKERS>1 the jobs run once per worker (they are idempotent, but if you
# want exactly-once, set ENABLE_SCHEDULER=false in the API workers and run the
# scheduler in a single dedicated process/container).
ENABLE_SCHEDULER=true

# Transactional email (cashier invitations) via Brevo. Leave BREVO_API_KEY empty
# and invitations are only written to the log, NOT emailed.
# EMAIL_FROM_ADDRESS must be a sender on a domain authenticated in Brevo
# (SPF + DKIM records), otherwise the emails land in spam.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TiendaStock

# Sentry DSN (optional — leave empty to disable).
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Web App (service: web)
# ---------------------------------------------------------------------------

# Internal URL the web container uses to reach the API container.
BACKEND_API_URL=http://api:8001

# Public-facing URL of the web app (used for meta tags, PWA, SEO, etc.).
# REQUIRED — this value is baked into the web build (NEXT_PUBLIC_APP_URL).
APP_URL=https://your-domain.com
