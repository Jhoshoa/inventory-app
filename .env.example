# =============================================================================
# Inventory App — Production Environment Variables
# =============================================================================
# Copy this file to .env at the project root and fill in your values.
#   cp .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution.
# Dokploy: paste these vars in the Environment Variables UI.
# =============================================================================

# ---------------------------------------------------------------------------
# Backend API (service: api)
# ---------------------------------------------------------------------------
APP_NAME=Inventory API
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# --- DATABASE AND AUTH (on this same server) --------------------------------
# Postgres (inventory-db) and Supabase Auth (inventory-auth) run in this compose
# file. Nothing is exposed to the internet: only the API, Auth and the backup
# reach them through Docker's internal network. Generate the four values with
#   python3 apps/backend/scripts/generate_auth_secrets.py
# and paste them here. Keep them only in Dokploy / .env, never in the repo.
#   POSTGRES_PASSWORD   letters and digits only (it goes inside DATABASE_URL)
#   JWT_SECRET          signs the sessions; changing it logs everybody out and
#                       requires generating both keys again
#   SUPABASE_*_KEY      JWTs signed with JWT_SECRET (role anon / service_role)
POSTGRES_PASSWORD=replace-with-generated-value
JWT_SECRET=replace-with-generated-value
SUPABASE_ANON_KEY=replace-with-generated-value
SUPABASE_SERVICE_ROLE_KEY=replace-with-generated-value

# Max Auth emails (confirm account, recovery) per hour, for the whole app.
AUTH_RATE_LIMIT_EMAIL_SENT=100

# --- GOOGLE SIGN-IN -------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web):
#   Authorized JavaScript origin:  ${APP_URL}
#   Authorized redirect URI:       ${APP_URL}/auth/v1/callback
# false hides nothing in the web but the API answers "Google no está activado".
AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Cloudinary — used for photo uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# FRONTEND_URL (links in emails, auth redirects) and CORS_ALLOWED_ORIGINS both
# default to APP_URL (see the web section below), so you normally set neither.
# Only define them if they must differ from the public URL.
# FRONTEND_URL=https://your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# Workers for gunicorn. 2 is enough for a 2 GB VPS; rate limits are kept in
# memory per worker, so more workers means proportionally looser limits.
WORKERS=2

# Daily jobs (trial expiry, grace period, archiving). Default true.
# With WORKERS>1 the jobs run once per worker (they are idempotent, but if you
# want exactly-once, set ENABLE_SCHEDULER=false in the API workers and run the
# scheduler in a single dedicated process/container).
ENABLE_SCHEDULER=true

# --- EMAIL (SMTP: Brevo today, any provider later) ---------------------------
# One SMTP account for every email: the API sends the invitations and Auth the
# account confirmation and password recovery (same templates, same sender).
# SMTP_HOST and SMTP_FROM_EMAIL are required: without them nobody could confirm
# their account. EMAIL_ENABLED=false only turns off the API's invitations (the
# link is then shown in Usuarios to share it by hand).
# SMTP_FROM_EMAIL must be on a domain authenticated in the provider (SPF + DKIM),
# otherwise the emails land in spam.
EMAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# starttls (587) or ssl (465). none is only allowed outside production (Mailpit).
SMTP_SECURITY=starttls
SMTP_USERNAME=your-login@smtp-brevo.com
SMTP_PASSWORD=your-smtp-key
SMTP_FROM_EMAIL=noreply@tutiendamiga.digital
SMTP_FROM_NAME=Tu Tiendamiga
# Optional: public PNG for the email header. Empty = ${APP_URL}/email/logo.png
EMAIL_LOGO_URL=

# --- DAILY BACKUP (service: inventory-db-backup) ------------------------------
# A pg_dump of the app and the Auth users every day from BACKUP_HOUR (local time
# of BACKUP_TIMEZONE), kept BACKUP_KEEP_DAYS days in a volume on this server.
# Strongly recommended: also copy it off the server to S3-compatible storage
# (Cloudflare R2, Backblaze B2, AWS S3), encrypted with BACKUP_PASSPHRASE.
# Restore: see docs/despliegue/servidor-propio.md.
BACKUP_TIMEZONE=America/La_Paz
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=inventory
# R2: https://<account-id>.r2.cloudflarestorage.com  B2: https://s3.<region>.backblazeb2.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Without it the off-server copy is NOT encrypted. Store it somewhere safe:
# without the passphrase the off-server copies cannot be restored.
BACKUP_PASSPHRASE=

# Sentry DSN (optional — leave empty to disable).
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Web App (service: web)
# ---------------------------------------------------------------------------

# Internal URL the web container uses to reach the API container.
BACKEND_API_URL=http://api:8001

# Public URL of the app: https://, no trailing slash. REQUIRED — the single
# value to change when the domain changes. Baked into the web build
# (NEXT_PUBLIC_APP_URL), so changing it needs a rebuild/redeploy, not a restart.
# Also the default for FRONTEND_URL and CORS_ALLOWED_ORIGINS.
APP_URL=https://your-domain.com

# Brand and public contact info (landing page, legal pages, contact page,
# WhatsApp button, PWA manifest, "request payment" in Settings).
# Baked into the web build like APP_URL: changing them needs a redeploy.
# Left empty they fall back to PLACEHOLDERS in apps/web/src/lib/brand.ts
# (a fake WhatsApp number 59170000000 and hola@tiendastock.com.bo), so set at
# least WHATSAPP_NUMBER and SUPPORT_EMAIL before going live.
BRAND_NAME=Tu Tiendamiga
SITE_DOMAIN=your-domain.com
SUPPORT_EMAIL=hola@your-domain.com
# Country code + number, digits only (Bolivia: 591 + 8 digits).
WHATSAPP_NUMBER=
