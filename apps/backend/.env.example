# ─── App ──────────────────────────────────────────
APP_NAME=Inventory API
APP_VERSION=0.1.0

# Cambiar a "production" en produccion (activa validaciones: no SQLite, no placeholders, DEBUG=false)
ENVIRONMENT=local

# DEBUG=true obliga a false cuando ENVIRONMENT=production
DEBUG=true

LOG_LEVEL=INFO
# Numero de workers gunicorn (default: CPU*2+1). Solo aplica en entrypoint.sh
# WORKERS=4
# Puerto del backend (default: 8001). Solo aplica en entrypoint.sh
# PORT=8001

# URL publica del frontend (usada para redirects de OAuth)
FRONTEND_URL=http://localhost:3010

# Origenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:8081

# Mostrar detalles de error al cliente. Default: =DEBUG (true en dev, false en prod)
# En produccion forzarlo a false: EXPOSE_ERROR_DETAILS=false
EXPOSE_ERROR_DETAILS=

# ─── Base de Datos ───────────────────────────────
# Desarrollo: SQLite (no requiere servidor externo)
# DATABASE_URL=sqlite+aiosqlite:///./inventory_dev.db
# Desarrollo: PostgreSQL local
# DATABASE_URL=postgresql+asyncpg://inventory:inventory@localhost:5432/inventory_dev
# Produccion: el Postgres del mismo servidor (lo arma docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@inventory-db:5432/postgres
# Con el stack local levantado (docker-compose.local.yml):
DATABASE_URL=postgresql+asyncpg://postgres:local-postgres-password@localhost:54322/postgres

# ─── Supabase Auth ───────────────────────────────
# Corre en el mismo servidor (servicio inventory-auth). Con el stack local, por
# su gateway publicado. Las claves son JWT firmados con JWT_SECRET: generarlas con
# python3 scripts/generate_auth_secrets.py (las de .env.local.example sirven en local).
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<tu-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>

# ─── Cloudinary (imagenes) ──────────────────────
CLOUDINARY_CLOUD_NAME=<tu-cloud-name>
CLOUDINARY_API_KEY=<tu-api-key>
CLOUDINARY_API_SECRET=<tu-api-secret>

# ─── Seguridad ───────────────────────────────────
# El mismo que usa Auth para firmar las sesiones y las dos claves de arriba.
# Generar con: python3 scripts/generate_auth_secrets.py
JWT_SECRET=<tu-jwt-secret>

# ─── Correo (SMTP) ───────────────────────────────
# Mismo codigo en desarrollo y en produccion; solo cambian estos valores.
# Desarrollo: el Mailpit del stack local (docker-compose.local.yml), en
# http://localhost:8025. Sin Mailpit: EMAIL_ENABLED=false (la invitacion queda
# en el log y la web muestra el enlace).
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tutiendamiga.digital
SMTP_FROM_NAME=Tu Tiendamiga
# Produccion (Brevo): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# SMTP_SECURITY=starttls y el usuario y la clave SMTP de Brevo.

# ─── Rate limiting (en memoria, por proceso) ────
# Login/registro por IP: limite bajo, son los endpoints tipicos de fuerza bruta.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Red de seguridad generosa por IP sobre el resto de la API (no limita uso normal).
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# ─── Ciclo de vida de tiendas suspendidas ───────
# Dias suspendida (sin pago) antes de archivarse automaticamente.
STORE_ARCHIVE_AFTER_SUSPENDED_DAYS=90

# ─── Monitoreo ──────────────────────────────────
SENTRY_DSN=
